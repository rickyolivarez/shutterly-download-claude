# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — your credentials never leave your machine.
#
# These are only used by manual_login.js to pre-fill the login form so
# you don't have to type them. You still complete login + any 2FA by hand,
# and the form is NOT auto-submitted.

SHUTTERFLY_EMAIL=your.email@example.com
SHUTTERFLY_PASSWORD=your-password-here
